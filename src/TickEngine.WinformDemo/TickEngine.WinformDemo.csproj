<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>TickEngine.WinformDemo</RootNamespace>
    <AssemblyName>TickEngine.WinformDemo</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TickEngine\TickEngine.csproj" />
    <!-- 开发期探针：WinForms 宿主 → 探针在后台线程启动常驻 Avalonia 应用后开窗 -->
    <ProjectReference Include="..\TickEngine.Probe.AvaloniaApp\TickEngine.Probe.AvaloniaApp.csproj" />
  </ItemGroup>

</Project>

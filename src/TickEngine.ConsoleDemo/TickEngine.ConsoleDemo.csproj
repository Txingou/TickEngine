<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 控制台宿主：探针是 Avalonia 应用（net8.0），由探针在后台线程启动，宿主无需 WinForms -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>TickEngine.ConsoleDemo</RootNamespace>
    <AssemblyName>TickEngine.ConsoleDemo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TickEngine\TickEngine.csproj" />
    <!-- 开发期探针：宿主进程内引用 → ProbeSession 自动启动常驻 Avalonia 探针应用并开窗 -->
    <ProjectReference Include="..\TickEngine.Probe.AvaloniaApp\TickEngine.Probe.AvaloniaApp.csproj" />
  </ItemGroup>

</Project>
